PORT=8787
# Optional AI. If empty, built-in rule strategy is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage. If MONGODB_URI is set, MongoDB is used. Otherwise SQLite fallback uses DATA_DIR/app.sqlite.
DATA_DIR=./data
MONGODB_URI=
MONGODB_DB=strategist_marketplaces
PUBLIC_URL=http://strateg-marketplaces.ru

# YooKassa payments. Keep real values only on VPS/.env or hosting secrets.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Ozon Seller API analytics.
OZON_CLIENT_ID=
OZON_API_KEY=
# Optional date override; default is last 30 days ending yesterday.
OZON_DATE_FROM=
OZON_DATE_TO=
OZON_ANALYTICS_LIMIT=1000
