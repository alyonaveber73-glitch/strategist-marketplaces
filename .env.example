PORT=8787
# Optional AI. If empty, built-in rule strategy is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage. SQLite database file is stored at DATA_DIR/app.sqlite.
DATA_DIR=./data
PUBLIC_URL=http://strateg-marketplaces.ru

# YooKassa payments. Keep real values only on VPS/.env or hosting secrets.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
